+    // ALTERNATIVE COMPLETE REPAIR: a separate debt ledger.
+    function _update(
+        address from,
+        address to,
+        uint256[] memory ids,
+        uint256[] memory values
+    ) internal virtual override {
+        uint256 moved = 0;
+        for (uint256 i = 0; i < values.length; i++) {
+            moved += values[i];
+        }
+        if (moved > 0) {
+            uint256 debt = (moved * accumulatedProfitPerNFT) / 1e18;
+            if (to != address(0)) {
+                _profitDebt[to] += debt;
+            }
+            if (from != address(0)) {
+                uint256 owed = _profitDebt[from];
+                _profitDebt[from] = owed > debt ? owed - debt : 0;
+            }
+        }
+        super._update(from, to, ids, values);
